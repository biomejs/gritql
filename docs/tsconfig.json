{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/universal/*": ["./src/universal/*"],
      "@/libs/*": ["./src/libs/*"],
      "@/statics/*": ["./src/statics/*"]
    },
    "jsx": "react-jsx"
  }
}
